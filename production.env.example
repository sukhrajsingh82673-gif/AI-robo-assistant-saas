# ==============================================================================
# ZONATA UNIVERSAL AI COMPANY OPERATING SYSTEM — V10 PRODUCTION ENVIRONMENT
# Enterprise Production Operating Unit Configuration Contract
# Enforces Least-Privilege Role Separation, Secret Isolation, and Zero Hardcoded Credentials
# ==============================================================================

# 1. Environment & Mode (development, staging, production)
ZONATA_ENV=production
APP_ENV=production
DEBUG=false

# 2. Sovereign Tenancy & Identification
ZONATA_SOVEREIGN_TENANT=tnt_enterprise_primary
ZONATA_SOVEREIGN_ORG=org_apex_global

# 3. Database Cluster & Least-Privilege Role Provisioning (PostgreSQL 16)
# MANDATORY: Never use DBA superuser (zonata_admin) for runtime API or worker traffic!
DATABASE_DIALECT=postgresql
POSTGRES_DB=zonata_production

# 3a. DBA Break-Glass Superuser (Used exclusively for initial cluster bootstrap and DBA maintenance)
POSTGRES_USER=zonata_admin
POSTGRES_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_DBA_SUPERUSER_PASSWORD_MIN_32_CHARS

# 3b. API Application Runtime Role (Least privilege: DML only - SELECT, INSERT, UPDATE, DELETE; NO DDL)
DB_APP_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_APP_PASSWORD_MIN_32_CHARS
DATABASE_URL=postgresql://zonata_app:REPLACE_WITH_HIGH_ENTROPY_APP_PASSWORD_MIN_32_CHARS@postgres:5432/zonata_production

# 3c. Background Worker Runtime Role (Least privilege: DML only for queue, events, tasks, evidence)
DB_WORKER_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_WORKER_PASSWORD_MIN_32_CHARS
WORKER_DATABASE_URL=postgresql://zonata_worker:REPLACE_WITH_HIGH_ENTROPY_WORKER_PASSWORD_MIN_32_CHARS@postgres:5432/zonata_production

# 3d. Schema Migration Runner Role (Dedicated DDL role for migrations/pg DDL execution)
DB_MIGRATOR_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_MIGRATOR_PASSWORD_MIN_32_CHARS
MIGRATOR_DATABASE_URL=postgresql://zonata_migrator:REPLACE_WITH_HIGH_ENTROPY_MIGRATOR_PASSWORD_MIN_32_CHARS@postgres:5432/zonata_production

# 3e. Database Pooling & Concurrency Controls
DATABASE_MIN_POOL_SIZE=10
DATABASE_MAX_POOL_SIZE=50
DATABASE_IDLE_TIMEOUT_SEC=300
DATABASE_BUSY_TIMEOUT_MS=60000

# 4. Cryptographic Security, Sovereign Authentication & Vault Master Keys
# Generate high entropy 64-character hex strings: openssl rand -hex 32
SECRET_VAULT_KEY=REPLACE_WITH_64_CHAR_HEX_KEY_FOR_AES_256_GCM
APPLICATION_SIGNING_KEY=REPLACE_WITH_64_CHAR_HEX_KEY_FOR_ED25519_OR_HMAC
ZONATA_AUTH_SECRET=REPLACE_WITH_HIGH_ENTROPY_64_CHAR_HEX_OR_BASE64_HMAC_SECRET
SOVEREIGN_ROOT_KEY_ID=key_sov_root_prod_202610
DUAL_KEY_AUTHORIZATION_ENABLED=true
ZONATA_STRICT_AUTH=1

# 5. Auxiliary Infrastructure Credentials
# MinIO / S3 Object Storage Credentials
MINIO_ROOT_USER=zonata_minio_admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_MINIO_PASSWORD_MIN_32_CHARS
S3_ENDPOINT=http://minio:9000
S3_BUCKET_EVIDENCE=zonata-evidence-production
S3_BUCKET_BACKUPS=zonata-backups-production
BACKUP_S3_BUCKET=zonata-backups-production
OFFHOST_BACKUP_ENABLED=1
OFFHOST_SYNC_INTERVAL_SEC=60

# Grafana Dashboard Admin Password
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_GRAFANA_ADMIN_PASSWORD_MIN_32_CHARS

# NATS JetStream & Temporal
NATS_URL=nats://nats:4222
TEMPORAL_HOST=temporal:7233
TEMPORAL_DB_USER=zonata_admin

# 6. Network, Ingress & Gateway CORS
HOST=0.0.0.0
PORT=8080
ALLOWED_ORIGINS=https://zonata.enterprise.internal,https://admin.enterprise.internal
TLS_CERT_PATH=/etc/ssl/certs/zonata_prod.crt
TLS_KEY_PATH=/etc/ssl/private/zonata_prod.key

# 7. Observability, Logging & SRE Telemetry
LOG_LEVEL=INFO
LOG_FORMAT=json
PROMETHEUS_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# 8. Model Router & AI Gateway Controls
APPROVED_MODELS=claude-3-5-sonnet,gemini-1.5-pro,gpt-4o
BLOCKED_MODELS=unvetted-external-model,local-unquantized-llama
MODEL_MAX_TOKEN_BURST=1000000
MAX_DAILY_MODEL_BUDGET_INR=50000.0

# 9. External Connectors & Payment Gateways
# Credentials must be provided by customer at onboarding or fetched from Vault
PMS_PROVIDER=OracleOperaCloud
PMS_CLIENT_ID=
PMS_CLIENT_SECRET=
PMS_PROPERTY_CODE=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_KEY=
