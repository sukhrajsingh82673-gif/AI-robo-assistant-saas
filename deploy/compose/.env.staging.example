# ==============================================================================
# ZONATA UNIVERSAL AI COMPANY OPERATING SYSTEM
# Cloud Staging Environment Variables (.env.staging.example)
# Populated from AWS Secrets Manager / Parameter Store during deployment
# ==============================================================================

# Target Deployment & Registry
ENVIRONMENT=staging
APP_ENV=staging
IMAGE_REGISTRY=zonata
IMAGE_TAG=26d553bfbc3cde126e22ff7e7c062d78383e63e1
# Domain Name & Ingress Routing
# For initial staging validation without a custom domain, use nip.io with EC2 public IP:
# e.g., DOMAIN_NAME=54.123.45.67.nip.io
DOMAIN_NAME=staging.nip.io
AWS_REGION=us-east-1

# Core Invariants & Security Flags
ZONATA_STRICT_AUTH=1
ZONATA_DISABLE_DEMO_SEED=1
ZONATA_CLEAN_STARTUP=1
ZONATA_ALLOW_HOST_SHELL=0

# Database Configuration (Private RDS PostgreSQL 16)
DB_HOST=zonata-staging-pg16.c1234567890.us-east-1.rds.amazonaws.com
DB_PORT=5432
POSTGRES_DB=zonata_production
POSTGRES_USER=zonata_admin
POSTGRES_PASSWORD=AUTOMATICALLY_INJECTED_FROM_SECRETS_MANAGER
DB_APP_PASSWORD=AUTOMATICALLY_INJECTED_FROM_SECRETS_MANAGER
DB_WORKER_PASSWORD=AUTOMATICALLY_INJECTED_FROM_SECRETS_MANAGER

DATABASE_URL=postgresql://zonata_app:${DB_APP_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}?sslmode=require
WORKER_DATABASE_URL=postgresql://zonata_worker:${DB_WORKER_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}?sslmode=require

# Database Connection Pool Sizing
DATABASE_MIN_POOL_SIZE=5
DATABASE_MAX_POOL_SIZE=25
DATABASE_IDLE_TIMEOUT_SEC=300
DATABASE_BUSY_TIMEOUT_MS=60000

# Authentication & Sessions
JWT_SECRET=AUTOMATICALLY_INJECTED_FROM_SECRETS_MANAGER
SESSION_SECRET=AUTOMATICALLY_INJECTED_FROM_SECRETS_MANAGER

# S3 WORM Immutable Backups
BACKUP_S3_BUCKET=zonata-staging-worm-backups-UNIQUE_ACCOUNT_SUFFIX
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# Observability Credentials
GF_SECURITY_ADMIN_PASSWORD=AUTOMATICALLY_INJECTED_FROM_SECRETS_MANAGER
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
PAGERDUTY_KEY=YOUR_PAGERDUTY_INTEGRATION_KEY
