aws_region                 = "us-east-1"
environment                = "staging"
# Staging domain: set to nip.io or custom domain (e.g. "staging.nip.io" or leave empty)
domain_name                = "staging.nip.io"
primary_backup_bucket_name = "zonata-staging-worm-backups-UNIQUE_ACCOUNT_SUFFIX"
replica_backup_bucket_name = "zonata-staging-worm-backups-crr-UNIQUE_ACCOUNT_SUFFIX"

