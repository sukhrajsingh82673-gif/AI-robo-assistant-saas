# ZONATA UNIVERSAL AI COMPANY OPERATING SYSTEM
# Production Schema Migration Runner Dockerfile
# Executes schema validation and database migrations before rollouts

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ZONATA_ENV=PRODUCTION \
    HOME=/app

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10001 zonata && \
    useradd -u 10001 -g zonata -s /bin/bash -m zonata

COPY --chown=zonata:zonata . /app

USER 10001:10001

ENTRYPOINT ["python3", "-c", "from core.database_engine import engine; res = engine.health_check(); print('Migration check:', res); exit(0 if res.get('status') == 'HEALTHY' else 1)"]
