# ==============================================================================
# ZONATA SaaS / Universal Robotic Assistant (URA)
# Production Environment Configuration Template
# ==============================================================================

# Core Application Environment
APP_ENV=production
ZONATA_ENV=production
PORT=8080
ZONATA_STRICT_AUTH=1
ZONATA_DISABLE_DEMO_SEED=1
ZONATA_CLEAN_STARTUP=1
ZONATA_REQUIRE_EXPLICIT_SECRET=1

# Sovereign Cryptographic Secret Keys
# Generate via: openssl rand -hex 32
ZONATA_AUTH_SECRET=CHANGE_ME_SOVEREIGN_64_CHAR_HEX_SIGNING_SECRET_KEY
ZONATA_BOOTSTRAP_SECRET=CHANGE_ME_ADMIN_BOOTSTRAP_PROVISIONING_SECRET
ZONATA_PREVIOUS_AUTH_SECRET=

# Database Dual-Engine Configuration
# For Production: Dedicated PostgreSQL 16+ instance
DATABASE_URL=postgresql://zonata_admin:CHANGE_ME_DB_PASSWORD@postgres:5432/zonata_production
DB_POOL_MIN=5
DB_POOL_MAX=25
DB_POOL_TIMEOUT=30

# File & Storage Paths
ZONATA_STORAGE_DIR=/app/storage
ZONATA_EVIDENCE_DIR=/app/storage/evidence

# Messaging & Event Bus (NATS JetStream)
NATS_URL=nats://nats:4222
NATS_CLUSTER_ID=zonata-cluster

# Workflow Orchestration (Temporal)
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=zonata-production

# Object Storage (S3 / MinIO Compatible)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=zonata-production-artifacts
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY

# OpenTelemetry & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=zonata-saas-production
PROMETHEUS_METRICS_ENABLED=1

# Security & Execution Governance
ZONATA_ENFORCE_CONTAINER_SANDBOX=1
ZONATA_ALLOW_HOST_FALLBACK=0
ZONATA_SANDBOX_TIMEOUT_SECONDS=60
ZONATA_RATE_LIMIT_PER_MINUTE=120
