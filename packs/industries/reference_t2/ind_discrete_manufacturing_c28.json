  "calculators": [
    {
      "calculator_id": "oee",
      "name": "Overall Equipment Effectiveness",
      "formula": "(availability * performance * quality) / 10000",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "availability": 90.0,
            "performance": 95.0,
            "quality": 98.0
          },
          "expected_output": 83.79,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "scrap_rate",
      "name": "Material Scrap Rate",
      "formula": "(scrap_weight / total_weight) * 100",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "scrap_weight": 50,
            "total_weight": 1000
          },
          "expected_output": 5.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "mtbf",
      "name": "Mean Time Between Failures",
      "formula": "total_operating_hours / failure_count",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_operating_hours": 1000,
            "failure_count": 4
          },
          "expected_output": 250.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "mttr",
      "name": "Mean Time to Repair",
      "formula": "total_downtime_hours / failure_count",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_downtime_hours": 20,
            "failure_count": 4
          },
          "expected_output": 5.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "takt_time",
      "name": "Takt Time per Unit",
      "formula": "available_production_time / customer_demand_units",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "available_production_time": 28800,
            "customer_demand_units": 400
          },
          "expected_output": 72.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "capacity_utilization",
      "name": "Shop Floor Capacity Utilization",
      "formula": "(actual_output / max_capacity) * 100",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_output": 800,
            "max_capacity": 1000
          },
          "expected_output": 80.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "wip_turnover",
      "name": "Work in Process Turnover",
      "formula": "cost_of_goods_sold / average_wip_value",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "cost_of_goods_sold": 500000,
            "average_wip_value": 50000
          },
          "expected_output": 10.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "first_pass_yield",
      "name": "First Pass Yield Percentage",
      "formula": "(good_units_initial / total_started_units) * 100",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "good_units_initial": 950,
            "total_started_units": 1000
          },
          "expected_output": 95.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "machine_downtime_ratio",
      "name": "Machine Downtime Ratio",
      "formula": "(downtime_hours / planned_operating_hours) * 100",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "downtime_hours": 10,
            "planned_operating_hours": 100
          },
          "expected_output": 10.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "changeover_efficiency",
      "name": "Tooling Changeover Ratio",
      "formula": "standard_changeover_mins / actual_changeover_mins",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "standard_changeover_mins": 30,
            "actual_changeover_mins": 40
          },
          "expected_output": 0.75,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "labor_productivity",
      "name": "Direct Labor Productivity",
      "formula": "total_units_produced / direct_labor_hours",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_units_produced": 500,
            "direct_labor_hours": 50
          },
          "expected_output": 10.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "material_cost_variance",
      "name": "Direct Material Cost Variance",
      "formula": "actual_material_cost - standard_material_cost",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_material_cost": 55000,
            "standard_material_cost": 50000
          },
          "expected_output": 5000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "defect_density",
      "name": "Defect Density per Thousand Units",
      "formula": "(defect_count / total_units) * 1000",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "defect_count": 12,
            "total_units": 6000
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "maintenance_cost_ratio",
      "name": "Maintenance Cost over Asset Value",
      "formula": "(maintenance_cost / total_asset_value) * 100",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "maintenance_cost": 25000,
            "total_asset_value": 500000
          },
          "expected_output": 5.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cycle_time_efficiency",
      "name": "Cycle Time Efficiency Ratio",
      "formula": "value_added_time / total_lead_time",
      "data_source": "folio_c28_ledger",
      "golden_tests": [
        {
          "inputs": {
            "value_added_time": 4,
            "total_lead_time": 20
          },
          "expected_output": 0.2,
          "tolerance": 0.01
        }
      ]
    }
