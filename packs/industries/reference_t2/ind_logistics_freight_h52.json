  "calculators": [
    {
      "calculator_id": "ton_km_cost",
      "name": "Freight Ton-Kilometer Cost",
      "formula": "total_trip_cost / (freight_weight_tons * distance_km)",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_trip_cost": 2500,
            "freight_weight_tons": 20,
            "distance_km": 500
          },
          "expected_output": 0.25,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "otif_rate",
      "name": "On-Time In-Full Delivery Rate",
      "formula": "(on_time_in_full_orders / total_dispatched_orders) * 100",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "on_time_in_full_orders": 950,
            "total_dispatched_orders": 1000
          },
          "expected_output": 95.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "empty_miles_ratio",
      "name": "Empty Haul Distance Ratio",
      "formula": "(empty_distance_km / total_distance_km) * 100",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "empty_distance_km": 150,
            "total_distance_km": 1000
          },
          "expected_output": 15.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "dock_to_stock_hours",
      "name": "Dock to Stock Turnaround Hours",
      "formula": "total_processing_hours / receiving_lots",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_processing_hours": 24,
            "receiving_lots": 8
          },
          "expected_output": 3.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "warehouse_cube_utilization",
      "name": "Warehouse Volumetric Storage Density",
      "formula": "(occupied_cubic_meters / total_storage_cubic_meters) * 100",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "occupied_cubic_meters": 8000,
            "total_storage_cubic_meters": 10000
          },
          "expected_output": 80.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "fuel_burn_variance",
      "name": "Fleet Fuel Burn Variance",
      "formula": "actual_fuel_liters - planned_fuel_liters",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_fuel_liters": 450,
            "planned_fuel_liters": 400
          },
          "expected_output": 50.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "demurrage_exposure_cost",
      "name": "Container Demurrage Accrual",
      "formula": "excess_dwell_days * daily_demurrage_rate",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "excess_dwell_days": 4,
            "daily_demurrage_rate": 150
          },
          "expected_output": 600.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "order_fill_rate",
      "name": "Warehouse Order Line Fill Rate",
      "formula": "(shipped_line_items / ordered_line_items) * 100",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "shipped_line_items": 4900,
            "ordered_line_items": 5000
          },
          "expected_output": 98.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "claims_per_mile",
      "name": "Cargo Damage Claims per Thousand Miles",
      "formula": "(damage_claims_count / fleet_miles) * 1000",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "damage_claims_count": 5,
            "fleet_miles": 50000
          },
          "expected_output": 0.1,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "crossdock_velocity",
      "name": "Cross-Dock Transit Hours",
      "formula": "crossdock_dispatch_hours / shipments_cleared",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "crossdock_dispatch_hours": 12,
            "shipments_cleared": 6
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cwt_shipping_cost",
      "name": "Hundredweight Shipping Rate",
      "formula": "(total_freight_cost / total_weight_lbs) * 100",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_freight_cost": 500,
            "total_weight_lbs": 10000
          },
          "expected_output": 5.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "dwell_time_ratio",
      "name": "Driver Detention Dwell Time Ratio",
      "formula": "detention_hours / scheduled_loading_hours",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "detention_hours": 3,
            "scheduled_loading_hours": 2
          },
          "expected_output": 1.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "payload_capacity_fill",
      "name": "Trailer Weight Utilization Percentage",
      "formula": "(cargo_weight / max_payload_weight) * 100",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "cargo_weight": 36000,
            "max_payload_weight": 40000
          },
          "expected_output": 90.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "route_variance_ratio",
      "name": "Route Distance Compliance Ratio",
      "formula": "actual_miles / planned_miles",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_miles": 550,
            "planned_miles": 500
          },
          "expected_output": 1.1,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "backhaul_revenue_rate",
      "name": "Backhaul Cost Offset Ratio",
      "formula": "backhaul_revenue / outbound_freight_cost",
      "data_source": "folio_h52_ledger",
      "golden_tests": [
        {
          "inputs": {
            "backhaul_revenue": 1200,
            "outbound_freight_cost": 2400
          },
          "expected_output": 0.5,
          "tolerance": 0.01
        }
      ]
    }
