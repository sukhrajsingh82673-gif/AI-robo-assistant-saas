  "calculators": [
    {
      "calculator_id": "billable_utilization",
      "name": "Billable Consultant Utilization",
      "formula": "(billable_hours / available_standard_hours) * 100",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "billable_hours": 1500,
            "available_standard_hours": 2000
          },
          "expected_output": 75.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "realization_rate",
      "name": "Billed Fee Realization Rate",
      "formula": "(realized_revenue / standard_rack_rate_fees) * 100",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "realized_revenue": 450000,
            "standard_rack_rate_fees": 500000
          },
          "expected_output": 90.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "rev_per_consultant",
      "name": "Revenue per Full-Time Consultant",
      "formula": "total_net_fees / full_time_consultants",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_net_fees": 1200000,
            "full_time_consultants": 4
          },
          "expected_output": 300000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "hourly_realized_rate",
      "name": "Average Realized Hourly Rate",
      "formula": "collected_fees / actual_hours_worked",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "collected_fees": 300000,
            "actual_hours_worked": 1200
          },
          "expected_output": 250.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "fee_multiplier",
      "name": "Fee to Labor Cost Multiplier",
      "formula": "billed_revenue / direct_payroll_cost",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "billed_revenue": 300000,
            "direct_payroll_cost": 100000
          },
          "expected_output": 3.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "dso",
      "name": "Days Sales Outstanding",
      "formula": "(accounts_receivable / annual_credit_sales) * 365",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "accounts_receivable": 100000,
            "annual_credit_sales": 730000
          },
          "expected_output": 50.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "project_overrun_variance",
      "name": "Project Cost Overrun Ratio",
      "formula": "(actual_project_cost - budgeted_cost) / budgeted_cost",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_project_cost": 110000,
            "budgeted_cost": 100000
          },
          "expected_output": 0.1,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "backlog_months",
      "name": "Firm Revenue Backlog Months",
      "formula": "signed_contract_backlog / average_monthly_burn",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "signed_contract_backlog": 600000,
            "average_monthly_burn": 100000
          },
          "expected_output": 6.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "client_retention_rate",
      "name": "Annual Client Retention Rate",
      "formula": "(retained_clients / baseline_clients) * 100",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "retained_clients": 85,
            "baseline_clients": 100
          },
          "expected_output": 85.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "engagement_margin",
      "name": "Engagement Contribution Margin",
      "formula": "((engagement_fee - direct_costs) / engagement_fee) * 100",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "engagement_fee": 100000,
            "direct_costs": 60000
          },
          "expected_output": 40.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "leverage_ratio",
      "name": "Staff to Partner Leverage Ratio",
      "formula": "associate_staff_heads / equity_partner_heads",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "associate_staff_heads": 16,
            "equity_partner_heads": 4
          },
          "expected_output": 4.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "fee_writeoff_ratio",
      "name": "Fee Write-Off Bad Debt Ratio",
      "formula": "(written_off_fees / total_billed_fees) * 100",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "written_off_fees": 15000,
            "total_billed_fees": 500000
          },
          "expected_output": 3.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "bid_win_rate",
      "name": "RFP Engagement Win Rate",
      "formula": "(won_proposals / submitted_proposals) * 100",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "won_proposals": 12,
            "submitted_proposals": 40
          },
          "expected_output": 30.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "fixed_fee_variance",
      "name": "Fixed-Price Engagement Variance",
      "formula": "fixed_contract_price - actual_incurred_cost",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "fixed_contract_price": 50000,
            "actual_incurred_cost": 42000
          },
          "expected_output": 8000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "idle_capacity_ratio",
      "name": "Bench Capacity Idle Ratio",
      "formula": "(unassigned_bench_hours / total_staff_hours) * 100",
      "data_source": "folio_m69_ledger",
      "golden_tests": [
        {
          "inputs": {
            "unassigned_bench_hours": 200,
            "total_staff_hours": 2000
          },
          "expected_output": 10.0,
          "tolerance": 0.01
        }
      ]
    }
  ],
