  "calculators": [
    {
      "calculator_id": "bed_occupancy_rate",
      "name": "Inpatient Bed Occupancy Rate",
      "formula": "(occupied_bed_days / total_available_bed_days) * 100",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "occupied_bed_days": 850,
            "total_available_bed_days": 1000
          },
          "expected_output": 85.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "alos",
      "name": "Average Length of Stay in Days",
      "formula": "total_inpatient_days / total_discharges_count",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_inpatient_days": 2000,
            "total_discharges_count": 400
          },
          "expected_output": 5.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cmi",
      "name": "Case Mix Index",
      "formula": "total_drg_relative_weights / total_patient_discharges",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_drg_relative_weights": 750,
            "total_patient_discharges": 500
          },
          "expected_output": 1.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "or_utilization",
      "name": "Surgical Operating Room Utilization Rate",
      "formula": "(actual_surgical_minutes / scheduled_room_minutes) * 100",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_surgical_minutes": 3600,
            "scheduled_room_minutes": 4500
          },
          "expected_output": 80.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "readmission_rate",
      "name": "30-Day Unplanned Readmission Rate",
      "formula": "(readmitted_patients_30d / total_discharges) * 100",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "readmitted_patients_30d": 36,
            "total_discharges": 450
          },
          "expected_output": 8.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "hai_rate",
      "name": "Hospital Acquired Infection Rate per Thousand Patient Days",
      "formula": "(infection_count / inpatient_days) * 1000",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "infection_count": 4,
            "inpatient_days": 2000
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "ed_dwell_time",
      "name": "Emergency Department Average Dwell Minutes",
      "formula": "total_ed_wait_and_treatment_minutes / total_ed_patients",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_ed_wait_and_treatment_minutes": 36000,
            "total_ed_patients": 200
          },
          "expected_output": 180.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "nurse_patient_ratio",
      "name": "Nurse to Patient Staffing Ratio",
      "formula": "assigned_patients_count / on_duty_nurses_count",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "assigned_patients_count": 16,
            "on_duty_nurses_count": 4
          },
          "expected_output": 4.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "revenue_per_discharge",
      "name": "Net Revenue per Adjusted Patient Discharge",
      "formula": "net_patient_revenue / adjusted_discharges_count",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "net_patient_revenue": 4500000,
            "adjusted_discharges_count": 500
          },
          "expected_output": 9000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "claims_denial_rate",
      "name": "Insurance Claims Initial Denial Rate",
      "formula": "(denied_claims_value / total_submitted_claims_value) * 100",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "denied_claims_value": 75000,
            "total_submitted_claims_value": 1500000
          },
          "expected_output": 5.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cost_per_case",
      "name": "Average Hospitalization Cost per Case",
      "formula": "total_inpatient_operating_costs / total_admitted_cases",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_inpatient_operating_costs": 3200000,
            "total_admitted_cases": 400
          },
          "expected_output": 8000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "imaging_idle_time",
      "name": "MRI and CT Scanner Idle Time Percentage",
      "formula": "(idle_equipment_hours / total_operational_hours) * 100",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "idle_equipment_hours": 15,
            "total_operational_hours": 100
          },
          "expected_output": 15.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "bad_debt_fraction",
      "name": "Healthcare Bad Debt Uncompensated Care Ratio",
      "formula": "(bad_debt_expense / gross_patient_revenue) * 100",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "bad_debt_expense": 40000,
            "gross_patient_revenue": 1000000
          },
          "expected_output": 4.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "med_dispense_accuracy",
      "name": "Pharmacy Dispense Accuracy Rate",
      "formula": "((total_dispensed_doses - error_doses) / total_dispensed_doses) * 100",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_dispensed_doses": 10000,
            "error_doses": 1
          },
          "expected_output": 99.99,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "ambulatory_no_show",
      "name": "Outpatient Clinic Appointment No-Show Rate",
      "formula": "(missed_appointments / total_scheduled_appointments) * 100",
      "data_source": "folio_q86_ledger",
      "golden_tests": [
        {
          "inputs": {
            "missed_appointments": 45,
            "total_scheduled_appointments": 450
          },
          "expected_output": 10.0,
          "tolerance": 0.01
        }
      ]
    }
  ],
