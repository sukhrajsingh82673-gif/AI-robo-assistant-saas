  "calculators": [
    {
      "calculator_id": "loss_ratio",
      "name": "Loss Ratio",
      "formula": "(incurred_claims_and_lae / earned_premiums) * 100",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "incurred_claims_and_lae": 650000,
            "earned_premiums": 1000000
          },
          "expected_output": 65.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "expense_ratio",
      "name": "Underwriting Expense Ratio",
      "formula": "(underwriting_expenses / written_premiums) * 100",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "underwriting_expenses": 280000,
            "written_premiums": 1000000
          },
          "expected_output": 28.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "combined_ratio",
      "name": "Combined Ratio",
      "formula": "((incurred_losses + expenses) / earned_premiums) * 100",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "incurred_losses": 650000,
            "expenses": 280000,
            "earned_premiums": 1000000
          },
          "expected_output": 93.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "lae_ratio",
      "name": "Loss Adjustment Expense Ratio",
      "formula": "(loss_adjustment_expenses / earned_premiums) * 100",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "loss_adjustment_expenses": 80000,
            "earned_premiums": 1000000
          },
          "expected_output": 8.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "premium_retention",
      "name": "Net Premium Retention Ratio",
      "formula": "(net_written_premiums / gross_written_premiums) * 100",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "net_written_premiums": 800000,
            "gross_written_premiums": 1000000
          },
          "expected_output": 80.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "solvency_scr_ratio",
      "name": "Solvency Capital Requirement Coverage",
      "formula": "(eligible_own_funds / solvency_capital_requirement) * 100",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "eligible_own_funds": 1800000,
            "solvency_capital_requirement": 1000000
          },
          "expected_output": 180.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "claims_velocity",
      "name": "Claims Settlement Velocity Days",
      "formula": "total_days_to_settle / claims_closed_count",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_days_to_settle": 360,
            "claims_closed_count": 24
          },
          "expected_output": 15.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "underwriting_profit",
      "name": "Underwriting Profit Margin",
      "formula": "((earned_premiums - incurred_losses - expenses) / earned_premiums) * 100",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "earned_premiums": 1000000,
            "incurred_losses": 650000,
            "expenses": 280000
          },
          "expected_output": 7.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "reinsurance_ceded_ratio",
      "name": "Reinsurance Ceded Fraction",
      "formula": "(ceded_premiums / gross_premiums) * 100",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "ceded_premiums": 200000,
            "gross_premiums": 1000000
          },
          "expected_output": 20.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cat_loss_load",
      "name": "Catastrophe Loss Ratio Contribution",
      "formula": "(catastrophe_losses / earned_premiums) * 100",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "catastrophe_losses": 50000,
            "earned_premiums": 1000000
          },
          "expected_output": 5.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "ibnr_factor",
      "name": "Incurred But Not Reported Reserve Factor",
      "formula": "estimated_ibnr_amount / reported_claims_amount",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "estimated_ibnr_amount": 250000,
            "reported_claims_amount": 1000000
          },
          "expected_output": 0.25,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "policy_persistency",
      "name": "Policyholder Persistency Rate",
      "formula": "(renewed_policies_count / eligible_renewal_count) * 100",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "renewed_policies_count": 880,
            "eligible_renewal_count": 1000
          },
          "expected_output": 88.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "claim_frequency",
      "name": "Claim Frequency per Thousand Policy Years",
      "formula": "(claims_count / policy_years_exposed) * 1000",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "claims_count": 45,
            "policy_years_exposed": 1000
          },
          "expected_output": 45.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "claim_severity",
      "name": "Average Incurred Claim Severity",
      "formula": "total_incurred_claims / claims_count",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_incurred_claims": 450000,
            "claims_count": 45
          },
          "expected_output": 10000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "investment_yield_reserves",
      "name": "Investment Yield on Float Reserves",
      "formula": "(net_investment_income / average_technical_reserves) * 100",
      "data_source": "folio_k65_ledger",
      "golden_tests": [
        {
          "inputs": {
            "net_investment_income": 120000,
            "average_technical_reserves": 3000000
          },
          "expected_output": 4.0,
          "tolerance": 0.01
        }
      ]
    }
