  "calculators": [
    {
      "calculator_id": "graduation_rate",
      "name": "Cohort Graduation Rate",
      "formula": "(graduated_students / cohort_intake_students) * 100",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "graduated_students": 850,
            "cohort_intake_students": 1000
          },
          "expected_output": 85.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "retention_rate",
      "name": "First Year Student Retention Rate",
      "formula": "(returning_second_year_students / first_year_cohort) * 100",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "returning_second_year_students": 900,
            "first_year_cohort": 1000
          },
          "expected_output": 90.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "student_faculty_ratio",
      "name": "Student to Faculty Ratio",
      "formula": "total_student_fte / total_faculty_fte",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_student_fte": 3000,
            "total_faculty_fte": 200
          },
          "expected_output": 15.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cost_per_degree",
      "name": "Institutional Cost per Awarded Degree",
      "formula": "total_instructional_expenditure / total_degrees_awarded",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_instructional_expenditure": 20000000,
            "total_degrees_awarded": 500
          },
          "expected_output": 40000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "tuition_discount_rate",
      "name": "Institutional Tuition Discount Rate",
      "formula": "(total_institutional_grant_aid / gross_tuition_revenue) * 100",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_institutional_grant_aid": 15000000,
            "gross_tuition_revenue": 50000000
          },
          "expected_output": 30.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "endowment_spending_rate",
      "name": "Endowment Annual Spending Rate",
      "formula": "(distributed_endowment_funds / average_endowment_market_value) * 100",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "distributed_endowment_funds": 4500000,
            "average_endowment_market_value": 100000000
          },
          "expected_output": 4.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "instructional_expense_ratio",
      "name": "Instructional Expense Ratio",
      "formula": "(instruction_spending / total_operating_budget) * 100",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "instruction_spending": 35000000,
            "total_operating_budget": 70000000
          },
          "expected_output": 50.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "course_completion_rate",
      "name": "Course Completion Rate",
      "formula": "(completed_course_enrollments / total_enrolled_seats) * 100",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "completed_course_enrollments": 9200,
            "total_enrolled_seats": 10000
          },
          "expected_output": 92.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "job_placement_rate",
      "name": "Post-Graduation Employment Rate",
      "formula": "(employed_graduates / reporting_graduates) * 100",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "employed_graduates": 450,
            "reporting_graduates": 500
          },
          "expected_output": 90.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "student_default_rate",
      "name": "Cohort Student Loan Default Rate",
      "formula": "(defaulted_borrowers / entering_repayment_borrowers) * 100",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "defaulted_borrowers": 15,
            "entering_repayment_borrowers": 500
          },
          "expected_output": 3.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "classroom_fill_rate",
      "name": "Classroom Seat Utilization Rate",
      "formula": "(enrolled_students / classroom_seat_capacity) * 100",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "enrolled_students": 40,
            "classroom_seat_capacity": 50
          },
          "expected_output": 80.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "grant_overhead_rate",
      "name": "Indirect Cost Recovery Rate",
      "formula": "(indirect_grant_revenue / direct_research_expenditures) * 100",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "indirect_grant_revenue": 2500000,
            "direct_research_expenditures": 5000000
          },
          "expected_output": 50.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "satisfaction_index",
      "name": "Student Satisfaction Index",
      "formula": "(positive_survey_responses / total_survey_responses) * 100",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "positive_survey_responses": 850,
            "total_survey_responses": 1000
          },
          "expected_output": 85.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "program_margin",
      "name": "Academic Department Contribution Margin",
      "formula": "((department_revenue - direct_expenses) / department_revenue) * 100",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "department_revenue": 2000000,
            "direct_expenses": 1400000
          },
          "expected_output": 30.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "admissions_yield",
      "name": "Admitted Student Acceptance Yield",
      "formula": "(matriculated_students / admitted_applicants) * 100",
      "data_source": "folio_p85_ledger",
      "golden_tests": [
        {
          "inputs": {
            "matriculated_students": 600,
            "admitted_applicants": 2000
          },
          "expected_output": 30.0,
          "tolerance": 0.01
        }
      ]
    }
