  "calculators": [
    {
      "calculator_id": "revpar",
      "name": "Revenue Per Available Room",
      "formula": "total_room_revenue / total_available_rooms",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_room_revenue": 100000,
            "total_available_rooms": 1000
          },
          "expected_output": 100.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "adr",
      "name": "Average Daily Room Rate",
      "formula": "total_room_revenue / total_rooms_sold",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_room_revenue": 100000,
            "total_rooms_sold": 800
          },
          "expected_output": 125.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "occ_rate",
      "name": "Hotel Room Occupancy Rate",
      "formula": "(total_rooms_sold / total_available_rooms) * 100",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_rooms_sold": 800,
            "total_available_rooms": 1000
          },
          "expected_output": 80.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "revpash",
      "name": "Revenue Per Available Seat Hour (F&B)",
      "formula": "total_fnb_revenue / (seat_count * open_hours)",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_fnb_revenue": 18000,
            "seat_count": 100,
            "open_hours": 6
          },
          "expected_output": 30.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cpor",
      "name": "Cost per Occupied Room",
      "formula": "total_operating_costs / total_rooms_sold",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_operating_costs": 40000,
            "total_rooms_sold": 800
          },
          "expected_output": 50.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "trevpar",
      "name": "Total Revenue Per Available Room",
      "formula": "total_property_revenue / total_available_rooms",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_property_revenue": 160000,
            "total_available_rooms": 1000
          },
          "expected_output": 160.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "goppar",
      "name": "Gross Operating Profit Per Available Room",
      "formula": "gross_operating_profit / total_available_rooms",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "gross_operating_profit": 65000,
            "total_available_rooms": 1000
          },
          "expected_output": 65.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "fnb_cost_percentage",
      "name": "Food and Beverage Cost Ratio",
      "formula": "(cost_of_food_and_beverage / fnb_sales_revenue) * 100",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "cost_of_food_and_beverage": 30000,
            "fnb_sales_revenue": 100000
          },
          "expected_output": 30.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cancellation_rate",
      "name": "Reservation Cancellation Rate",
      "formula": "(cancelled_reservations / total_booked_reservations) * 100",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "cancelled_reservations": 120,
            "total_booked_reservations": 800
          },
          "expected_output": 15.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "direct_booking_ratio",
      "name": "Direct Channel Booking Ratio",
      "formula": "(direct_bookings / total_bookings) * 100",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "direct_bookings": 400,
            "total_bookings": 800
          },
          "expected_output": 50.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "average_los",
      "name": "Average Length of Guest Stay Days",
      "formula": "total_guest_nights / total_bookings_count",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_guest_nights": 2400,
            "total_bookings_count": 800
          },
          "expected_output": 3.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "staff_per_hundred_keys",
      "name": "Staffing Intensity per 100 Rooms",
      "formula": "(total_hotel_staff / total_available_rooms) * 100",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_hotel_staff": 60,
            "total_available_rooms": 100
          },
          "expected_output": 60.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "ancillary_spend_per_guest",
      "name": "Ancillary Non-Room Spend per Guest",
      "formula": "ancillary_revenue / total_registered_guests",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "ancillary_revenue": 45000,
            "total_registered_guests": 1500
          },
          "expected_output": 30.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "no_show_ratio",
      "name": "Guest No-Show Percentage",
      "formula": "(no_show_reservations / confirmed_reservations) * 100",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "no_show_reservations": 16,
            "confirmed_reservations": 800
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "guest_satisfaction_index",
      "name": "Guest CSAT Positive Rating Rate",
      "formula": "(five_star_reviews / total_reviewed_stays) * 100",
      "data_source": "folio_i55_ledger",
      "golden_tests": [
        {
          "inputs": {
            "five_star_reviews": 720,
            "total_reviewed_stays": 800
          },
          "expected_output": 90.0,
          "tolerance": 0.01
        }
      ]
    }
