  "calculators": [
    {
      "calculator_id": "budget_execution_rate",
      "name": "Program Budget Execution Rate",
      "formula": "(actual_disbursed_funds / allocated_annual_budget) * 100",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_disbursed_funds": 8500000,
            "allocated_annual_budget": 10000000
          },
          "expected_output": 85.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "service_delivery_cycle",
      "name": "Civic Permit Turnaround Days",
      "formula": "total_processing_days / completed_permit_applications",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_processing_days": 1500,
            "completed_permit_applications": 100
          },
          "expected_output": 15.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "disbursement_accuracy",
      "name": "Entitlement Payment Accuracy Ratio",
      "formula": "((total_payments - overpayment_errors) / total_payments) * 100",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_payments": 50000,
            "overpayment_errors": 50
          },
          "expected_output": 99.9,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "fund_absorption",
      "name": "Public Grant Absorption Ratio",
      "formula": "(spent_grant_funds / awarded_grant_amount) * 100",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "spent_grant_funds": 450000,
            "awarded_grant_amount": 500000
          },
          "expected_output": 90.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "foia_compliance_rate",
      "name": "Freedom of Information Timely Response Rate",
      "formula": "(timely_foia_responses / total_foia_requests) * 100",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "timely_foia_responses": 95,
            "total_foia_requests": 100
          },
          "expected_output": 95.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "asset_maintenance_ratio",
      "name": "Public Infrastructure Maintenance Expenditure Rate",
      "formula": "(actual_maintenance_spend / replacement_asset_value) * 100",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_maintenance_spend": 200000,
            "replacement_asset_value": 10000000
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "grant_variance",
      "name": "Civic Grant Program Variance",
      "formula": "awarded_grant_amount - actual_spent_grant",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "awarded_grant_amount": 100000,
            "actual_spent_grant": 95000
          },
          "expected_output": 5000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "tax_compliance_rate",
      "name": "Municipal Tax Assessment Collection Rate",
      "formula": "(collected_local_taxes / billed_local_taxes) * 100",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "collected_local_taxes": 9200000,
            "billed_local_taxes": 10000000
          },
          "expected_output": 92.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "citizen_complaint_resolution",
      "name": "Citizen Grievance Resolution Rate",
      "formula": "(resolved_grievances / logged_grievances) * 100",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "resolved_grievances": 450,
            "logged_grievances": 500
          },
          "expected_output": 90.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "admin_overhead_ratio",
      "name": "Administrative Overhead to Program Expense Ratio",
      "formula": "(general_admin_expense / direct_program_expense) * 100",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "general_admin_expense": 800000,
            "direct_program_expense": 10000000
          },
          "expected_output": 8.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "procurement_savings_rate",
      "name": "Public Tender Price Savings Rate",
      "formula": "((benchmark_tender_estimate - winning_bid_amount) / benchmark_tender_estimate) * 100",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "benchmark_tender_estimate": 1000000,
            "winning_bid_amount": 850000
          },
          "expected_output": 15.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "sroi",
      "name": "Social Return on Investment Ratio",
      "formula": "monetized_social_impact_value / total_public_investment",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "monetized_social_impact_value": 4500000,
            "total_public_investment": 1500000
          },
          "expected_output": 3.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "inspection_completion_rate",
      "name": "Statutory Regulatory Inspection Completion Rate",
      "formula": "(completed_inspections / mandated_inspections) * 100",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "completed_inspections": 480,
            "mandated_inspections": 500
          },
          "expected_output": 96.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "citizen_wait_ratio",
      "name": "Average Citizen Counter Wait Hours",
      "formula": "total_waiting_hours / total_citizens_served",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_waiting_hours": 100,
            "total_citizens_served": 200
          },
          "expected_output": 0.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "fraud_prevention_rate",
      "name": "Improper Payment Interception Ratio",
      "formula": "(intercepted_fraud_claims / total_investigated_fraud) * 100",
      "data_source": "folio_o84_ledger",
      "golden_tests": [
        {
          "inputs": {
            "intercepted_fraud_claims": 80,
            "total_investigated_fraud": 100
          },
          "expected_output": 80.0,
          "tolerance": 0.01
        }
      ]
    }
  ],
