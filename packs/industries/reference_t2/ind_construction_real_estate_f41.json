  "calculators": [
    {
      "calculator_id": "cpi",
      "name": "Cost Performance Index",
      "formula": "earned_value / actual_cost",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "earned_value": 800000,
            "actual_cost": 1000000
          },
          "expected_output": 0.8,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "spi",
      "name": "Schedule Performance Index",
      "formula": "earned_value / planned_value",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "earned_value": 850000,
            "planned_value": 1000000
          },
          "expected_output": 0.85,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cap_rate",
      "name": "Capitalization Rate Percentage",
      "formula": "(net_operating_income / current_market_value) * 100",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "net_operating_income": 70000,
            "current_market_value": 1000000
          },
          "expected_output": 7.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "noi",
      "name": "Annual Net Operating Income",
      "formula": "gross_operating_income - operating_expenses",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "gross_operating_income": 120000,
            "operating_expenses": 40000
          },
          "expected_output": 80000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "ltc",
      "name": "Loan to Construction Cost",
      "formula": "(construction_loan_amount / total_development_cost) * 100",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "construction_loan_amount": 700000,
            "total_development_cost": 1000000
          },
          "expected_output": 70.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "retainage_accrual",
      "name": "Subcontractor Retainage Holdback",
      "formula": "billed_work_amount * (retainage_percentage / 100)",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "billed_work_amount": 200000,
            "retainage_percentage": 10
          },
          "expected_output": 20000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "square_meter_cost",
      "name": "Cost per Square Meter Construction",
      "formula": "total_construction_expenditure / gross_floor_area_sqm",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_construction_expenditure": 5000000,
            "gross_floor_area_sqm": 2500
          },
          "expected_output": 2000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "change_order_ratio",
      "name": "Change Order Budget Impact Percentage",
      "formula": "(change_order_total / baseline_contract_value) * 100",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "change_order_total": 80000,
            "baseline_contract_value": 1000000
          },
          "expected_output": 8.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "punch_defect_density",
      "name": "Punch List Defects per Thousand SqM",
      "formula": "(defect_items_count / gross_area_sqm) * 1000",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "defect_items_count": 25,
            "gross_area_sqm": 5000
          },
          "expected_output": 5.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cash_on_cash",
      "name": "Cash on Cash Return",
      "formula": "(annual_pretax_cash_flow / total_cash_invested) * 100",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "annual_pretax_cash_flow": 24000,
            "total_cash_invested": 300000
          },
          "expected_output": 8.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "occupancy_rate",
      "name": "Leased Occupancy Percentage",
      "formula": "(occupied_leasable_sqm / total_leasable_sqm) * 100",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "occupied_leasable_sqm": 9200,
            "total_leasable_sqm": 10000
          },
          "expected_output": 92.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "debt_yield",
      "name": "Debt Yield Ratio",
      "formula": "(net_operating_income / total_loan_balance) * 100",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "net_operating_income": 100000,
            "total_loan_balance": 1000000
          },
          "expected_output": 10.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "trir",
      "name": "Total Recordable Incident Rate",
      "formula": "(recordable_incidents * 200000) / total_man_hours",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "recordable_incidents": 2,
            "total_man_hours": 200000
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "progress_billing_variance",
      "name": "Progress Billing Variance",
      "formula": "billed_to_date - earned_value_to_date",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "billed_to_date": 550000,
            "earned_value_to_date": 500000
          },
          "expected_output": 50000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "completion_estimate_variance",
      "name": "Estimate at Completion Variance",
      "formula": "forecast_completion_cost - budget_at_completion",
      "data_source": "folio_f41_ledger",
      "golden_tests": [
        {
          "inputs": {
            "forecast_completion_cost": 1050000,
            "budget_at_completion": 1000000
          },
          "expected_output": 50000.0,
          "tolerance": 0.01
        }
      ]
    }
