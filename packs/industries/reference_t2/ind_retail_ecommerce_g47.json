  "calculators": [
    {
      "calculator_id": "gmv_net_revenue",
      "name": "Net Merchandise Revenue Ratio",
      "formula": "net_sales / gross_merchandise_value",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "net_sales": 850000,
            "gross_merchandise_value": 1000000
          },
          "expected_output": 0.85,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "return_rate",
      "name": "Customer Return Rate",
      "formula": "(returned_units / total_sold_units) * 100",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "returned_units": 150,
            "total_sold_units": 1500
          },
          "expected_output": 10.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cac",
      "name": "Customer Acquisition Cost",
      "formula": "total_marketing_spend / new_customers_acquired",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_marketing_spend": 50000,
            "new_customers_acquired": 1000
          },
          "expected_output": 50.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "ltv",
      "name": "Customer Lifetime Value",
      "formula": "average_order_value * purchase_frequency * lifespan_years",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "average_order_value": 80,
            "purchase_frequency": 4,
            "lifespan_years": 3
          },
          "expected_output": 960.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "inventory_turnover",
      "name": "Inventory Turnover Ratio",
      "formula": "cost_of_goods_sold / average_inventory_value",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "cost_of_goods_sold": 600000,
            "average_inventory_value": 100000
          },
          "expected_output": 6.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "aov",
      "name": "Average Order Value",
      "formula": "total_revenue / order_count",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_revenue": 120000,
            "order_count": 1500
          },
          "expected_output": 80.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cart_abandonment",
      "name": "Shopping Cart Abandonment Rate",
      "formula": "((initiated_carts - completed_orders) / initiated_carts) * 100",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "initiated_carts": 1000,
            "completed_orders": 300
          },
          "expected_output": 70.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "sell_through_rate",
      "name": "Merchandise Sell-Through Rate",
      "formula": "(units_sold / initial_inventory_received) * 100",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "units_sold": 800,
            "initial_inventory_received": 1000
          },
          "expected_output": 80.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "gmroi",
      "name": "Gross Margin Return on Investment",
      "formula": "gross_margin_dollars / average_inventory_cost",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "gross_margin_dollars": 150000,
            "average_inventory_cost": 75000
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "dsi",
      "name": "Days Sales of Inventory",
      "formula": "(average_inventory / cost_of_goods_sold) * 365",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "average_inventory": 50000,
            "cost_of_goods_sold": 365000
          },
          "expected_output": 50.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "fulfillment_cost_per_order",
      "name": "Fulfillment Cost per Shipped Order",
      "formula": "total_warehouse_shipping_costs / total_shipped_orders",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_warehouse_shipping_costs": 45000,
            "total_shipped_orders": 9000
          },
          "expected_output": 5.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "repurchase_rate",
      "name": "Repeat Buyer Percentage",
      "formula": "(repeat_customers / total_active_customers) * 100",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "repeat_customers": 400,
            "total_active_customers": 1000
          },
          "expected_output": 40.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "markdown_percentage",
      "name": "Markdown Discount Rate",
      "formula": "(discount_reduction_value / original_retail_value) * 100",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "discount_reduction_value": 20000,
            "original_retail_value": 100000
          },
          "expected_output": 20.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "shrinkage_ratio",
      "name": "Inventory Shrinkage Percentage",
      "formula": "(shrinkage_loss_value / total_expected_inventory) * 100",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "shrinkage_loss_value": 15000,
            "total_expected_inventory": 1000000
          },
          "expected_output": 1.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "conversion_rate",
      "name": "E-Commerce Conversion Rate",
      "formula": "(completed_orders / total_site_sessions) * 100",
      "data_source": "folio_g47_ledger",
      "golden_tests": [
        {
          "inputs": {
            "completed_orders": 250,
            "total_site_sessions": 10000
          },
          "expected_output": 2.5,
          "tolerance": 0.01
        }
      ]
    }
