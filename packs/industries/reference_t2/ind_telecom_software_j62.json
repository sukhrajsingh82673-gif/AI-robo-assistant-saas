  "calculators": [
    {
      "calculator_id": "mrr",
      "name": "Monthly Recurring Revenue Total",
      "formula": "subscriber_count * average_subscription_fee",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "subscriber_count": 2500,
            "average_subscription_fee": 40
          },
          "expected_output": 100000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "arr",
      "name": "Annual Recurring Revenue",
      "formula": "monthly_recurring_revenue * 12",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "monthly_recurring_revenue": 100000
          },
          "expected_output": 1200000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "nrr",
      "name": "Net Revenue Retention Percentage",
      "formula": "((starting_mrr + expansion_mrr - churned_mrr - contraction_mrr) / starting_mrr) * 100",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "starting_mrr": 100000,
            "expansion_mrr": 20000,
            "churned_mrr": 5000,
            "contraction_mrr": 2000
          },
          "expected_output": 113.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "grr",
      "name": "Gross Revenue Retention Percentage",
      "formula": "((starting_mrr - churned_mrr - contraction_mrr) / starting_mrr) * 100",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "starting_mrr": 100000,
            "churned_mrr": 5000,
            "contraction_mrr": 2000
          },
          "expected_output": 93.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "churn_rate",
      "name": "Monthly Customer Churn Rate",
      "formula": "(lost_customers / starting_customers) * 100",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "lost_customers": 40,
            "starting_customers": 2000
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "magic_number",
      "name": "SaaS Magic Number Sales Efficiency",
      "formula": "(net_new_arr_quarter * 4) / prior_quarter_sales_marketing_expense",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "net_new_arr_quarter": 250000,
            "prior_quarter_sales_marketing_expense": 1000000
          },
          "expected_output": 1.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cac_payback",
      "name": "CAC Payback Period in Months",
      "formula": "customer_acquisition_cost / (monthly_arpu * gross_margin_fraction)",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "customer_acquisition_cost": 1200,
            "monthly_arpu": 100,
            "gross_margin_fraction": 0.8
          },
          "expected_output": 15.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "arpu",
      "name": "Average Revenue Per User",
      "formula": "total_service_revenue / active_users_count",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_service_revenue": 500000,
            "active_users_count": 10000
          },
          "expected_output": 50.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "rule_of_40",
      "name": "Rule of 40 Efficiency Index",
      "formula": "revenue_growth_rate_pct + free_cash_flow_margin_pct",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "revenue_growth_rate_pct": 30,
            "free_cash_flow_margin_pct": 15
          },
          "expected_output": 45.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "uptime_percentage",
      "name": "Service SLA Availability Percentage",
      "formula": "((total_minutes - downtime_minutes) / total_minutes) * 100",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_minutes": 43200,
            "downtime_minutes": 4.32
          },
          "expected_output": 99.99,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "bandwidth_utilization",
      "name": "Network Peak Bandwidth Utilization",
      "formula": "(peak_bandwidth_gbps / provisioned_bandwidth_gbps) * 100",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "peak_bandwidth_gbps": 80,
            "provisioned_bandwidth_gbps": 100
          },
          "expected_output": 80.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "infra_cost_per_mau",
      "name": "Cloud Infrastructure Cost per Active User",
      "formula": "total_monthly_cloud_bill / monthly_active_users",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_monthly_cloud_bill": 50000,
            "monthly_active_users": 100000
          },
          "expected_output": 0.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "api_latency_p99_variance",
      "name": "API P99 Latency SLA Variance",
      "formula": "actual_p99_ms - target_sla_p99_ms",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_p99_ms": 140,
            "target_sla_p99_ms": 100
          },
          "expected_output": 40.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "saas_gross_margin",
      "name": "Software Platform Gross Margin",
      "formula": "((total_revenue - hosting_support_cogs) / total_revenue) * 100",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_revenue": 1000000,
            "hosting_support_cogs": 200000
          },
          "expected_output": 80.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "subscriber_ltv",
      "name": "Customer Lifetime Value Total",
      "formula": "arpu / (churn_rate_decimal)",
      "data_source": "folio_j62_ledger",
      "golden_tests": [
        {
          "inputs": {
            "arpu": 50,
            "churn_rate_decimal": 0.02
          },
          "expected_output": 2500.0,
          "tolerance": 0.01
        }
      ]
    }
