  "calculators": [
    {
      "calculator_id": "yield_per_hectare",
      "name": "Harvest Yield per Hectare",
      "formula": "total_harvest_metric_tons / harvested_hectares",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_harvest_metric_tons": 800,
            "harvested_hectares": 100
          },
          "expected_output": 8.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "crop_moisture_variance",
      "name": "Grain Moisture Content Variance",
      "formula": "harvested_moisture_pct - standard_storage_moisture_pct",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "harvested_moisture_pct": 16.5,
            "standard_storage_moisture_pct": 14.0
          },
          "expected_output": 2.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "fcr",
      "name": "Livestock Feed Conversion Ratio",
      "formula": "total_feed_consumed_kg / total_weight_gained_kg",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_feed_consumed_kg": 4000,
            "total_weight_gained_kg": 2000
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "irrigation_productivity",
      "name": "Water Productivity Index",
      "formula": "total_yield_kg / irrigation_volume_cubic_meters",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_yield_kg": 800000,
            "irrigation_volume_cubic_meters": 400000
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "harvest_loss_rate",
      "name": "Field Harvest Loss Rate",
      "formula": "(unharvested_shattered_grain_kg / total_standing_yield_kg) * 100",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "unharvested_shattered_grain_kg": 24,
            "total_standing_yield_kg": 800
          },
          "expected_output": 3.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "fertilizer_efficiency",
      "name": "Nitrogen Fertilizer Recovery Efficiency",
      "formula": "nitrogen_taken_up_kg / nitrogen_applied_kg",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "nitrogen_taken_up_kg": 75,
            "nitrogen_applied_kg": 100
          },
          "expected_output": 0.75,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "post_harvest_spoilage",
      "name": "Silo Storage Spoilage Ratio",
      "formula": "(spoiled_storage_tons / total_silo_tons) * 100",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "spoiled_storage_tons": 10,
            "total_silo_tons": 1000
          },
          "expected_output": 1.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "machinery_cost_per_acre",
      "name": "Tractor & Implement Cost per Acre",
      "formula": "annual_equipment_operating_cost / farm_acres",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "annual_equipment_operating_cost": 45000,
            "farm_acres": 1500
          },
          "expected_output": 30.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "livestock_mortality_rate",
      "name": "Herd Annual Mortality Rate",
      "formula": "(dead_animals_count / total_herd_size) * 100",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "dead_animals_count": 10,
            "total_herd_size": 1000
          },
          "expected_output": 1.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "seed_germination_rate",
      "name": "Certified Seed Germination Percentage",
      "formula": "(germinated_seeds / sample_planted_seeds) * 100",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "germinated_seeds": 96,
            "sample_planted_seeds": 100
          },
          "expected_output": 96.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "soil_carbon_gain",
      "name": "Soil Organic Matter Index",
      "formula": "measured_som_pct - baseline_som_pct",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "measured_som_pct": 3.8,
            "baseline_som_pct": 3.2
          },
          "expected_output": 0.6,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "spray_application_accuracy",
      "name": "Chemical Application Rate Variance",
      "formula": "actual_applied_liters_per_ha - label_rate_liters_per_ha",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_applied_liters_per_ha": 105,
            "label_rate_liters_per_ha": 100
          },
          "expected_output": 5.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "working_capital_turnover",
      "name": "Agricultural Working Capital Turnover",
      "formula": "annual_crop_sales / seasonal_operating_debt",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "annual_crop_sales": 600000,
            "seasonal_operating_debt": 300000
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "fuel_per_hectare",
      "name": "Field Tractor Fuel Consumption Intensity",
      "formula": "fuel_consumed_liters / tilled_hectares",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "fuel_consumed_liters": 2500,
            "tilled_hectares": 100
          },
          "expected_output": 25.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "calving_rate",
      "name": "Breeding Herd Weaning Percentage",
      "formula": "(weaned_calves_count / bred_cows_count) * 100",
      "data_source": "folio_a01_ledger",
      "golden_tests": [
        {
          "inputs": {
            "weaned_calves_count": 90,
            "bred_cows_count": 100
          },
          "expected_output": 90.0,
          "tolerance": 0.01
        }
      ]
    }
