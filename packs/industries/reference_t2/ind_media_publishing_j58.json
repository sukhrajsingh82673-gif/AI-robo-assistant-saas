  "calculators": [
    {
      "calculator_id": "cpm",
      "name": "Advertising Cost per Mille Impressions",
      "formula": "(advertising_spend / total_impressions) * 1000",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "advertising_spend": 25000,
            "total_impressions": 1000000
          },
          "expected_output": 25.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "ctr",
      "name": "Click Through Rate",
      "formula": "(total_clicks / total_impressions) * 100",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_clicks": 2500,
            "total_impressions": 100000
          },
          "expected_output": 2.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "circulation_rev_ratio",
      "name": "Reader Subscription Revenue Contribution",
      "formula": "(subscription_revenue / total_media_revenue) * 100",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "subscription_revenue": 600000,
            "total_media_revenue": 1000000
          },
          "expected_output": 60.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "production_cost_per_min",
      "name": "Video Content Production Cost per Minute",
      "formula": "total_production_budget / video_duration_minutes",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_production_budget": 120000,
            "video_duration_minutes": 60
          },
          "expected_output": 2000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "sub_churn",
      "name": "Digital Subscriber Monthly Churn Rate",
      "formula": "(cancelled_subscribers / starting_subscribers) * 100",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "cancelled_subscribers": 150,
            "starting_subscribers": 5000
          },
          "expected_output": 3.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "ad_fill_rate",
      "name": "Ad Inventory Monetization Fill Rate",
      "formula": "(served_ad_impressions / available_ad_slots) * 100",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "served_ad_impressions": 850000,
            "available_ad_slots": 1000000
          },
          "expected_output": 85.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "subscriber_ltv",
      "name": "Media Subscriber Lifetime Value",
      "formula": "average_monthly_subscription_fee / monthly_churn_rate_decimal",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "average_monthly_subscription_fee": 15,
            "monthly_churn_rate_decimal": 0.03
          },
          "expected_output": 500.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "royalty_variance",
      "name": "Content Licensing Royalty Variance",
      "formula": "accrued_royalties - minimum_guaranteed_advance",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "accrued_royalties": 45000,
            "minimum_guaranteed_advance": 40000
          },
          "expected_output": 5000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "editorial_turnaround",
      "name": "Manuscript Editorial Turnaround Days",
      "formula": "total_editing_days / reviewed_manuscripts",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_editing_days": 180,
            "reviewed_manuscripts": 12
          },
          "expected_output": 15.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "syndication_yield",
      "name": "Syndication Revenue per Article",
      "formula": "total_syndicated_fees / published_articles_count",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_syndicated_fees": 30000,
            "published_articles_count": 100
          },
          "expected_output": 300.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "audience_retention",
      "name": "Video Average Watch Duration Percentage",
      "formula": "(average_watch_seconds / total_video_duration_seconds) * 100",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "average_watch_seconds": 180,
            "total_video_duration_seconds": 300
          },
          "expected_output": 60.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "rights_amortization",
      "name": "Content Rights Amortization Expense",
      "formula": "total_rights_acquisition_cost / licensed_lifespan_months",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_rights_acquisition_cost": 240000,
            "licensed_lifespan_months": 24
          },
          "expected_output": 10000.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "stream_completion_rate",
      "name": "Full Media Stream Completion Rate",
      "formula": "(completed_streams / initiated_streams) * 100",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "completed_streams": 7500,
            "initiated_streams": 10000
          },
          "expected_output": 75.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "press_wastage_rate",
      "name": "Print Run Paper Wastage Percentage",
      "formula": "(spoiled_paper_reams / total_press_reams) * 100",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "spoiled_paper_reams": 40,
            "total_press_reams": 1000
          },
          "expected_output": 4.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "rocs",
      "name": "Return on Content Spend Ratio",
      "formula": "net_content_generated_revenue / total_content_creation_spend",
      "data_source": "folio_j58_ledger",
      "golden_tests": [
        {
          "inputs": {
            "net_content_generated_revenue": 300000,
            "total_content_creation_spend": 100000
          },
          "expected_output": 3.0,
          "tolerance": 0.01
        }
      ]
    }
  ],
