  "calculators": [
    {
      "calculator_id": "dscr",
      "name": "Debt Service Coverage Ratio",
      "formula": "net_operating_income / total_debt_service",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "net_operating_income": 150000,
            "total_debt_service": 100000
          },
          "expected_output": 1.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "ltv",
      "name": "Loan to Value Ratio",
      "formula": "(loan_principal_amount / appraised_property_value) * 100",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "loan_principal_amount": 750000,
            "appraised_property_value": 1000000
          },
          "expected_output": 75.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "nim",
      "name": "Net Interest Margin Percentage",
      "formula": "((interest_income - interest_expense) / average_earning_assets) * 100",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "interest_income": 60000,
            "interest_expense": 20000,
            "average_earning_assets": 1000000
          },
          "expected_output": 4.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "npl_ratio",
      "name": "Non-Performing Loan Ratio",
      "formula": "(non_performing_loans / total_loan_portfolio) * 100",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "non_performing_loans": 250000,
            "total_loan_portfolio": 10000000
          },
          "expected_output": 2.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "tier1_capital_ratio",
      "name": "Tier 1 Capital Adequacy Ratio",
      "formula": "(tier1_capital / risk_weighted_assets) * 100",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "tier1_capital": 1200000,
            "risk_weighted_assets": 8000000
          },
          "expected_output": 15.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cost_of_funds",
      "name": "Weighted Cost of Funds",
      "formula": "(interest_expense / total_interest_bearing_liabilities) * 100",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "interest_expense": 30000,
            "total_interest_bearing_liabilities": 1000000
          },
          "expected_output": 3.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "efficiency_ratio",
      "name": "Banking Efficiency Ratio",
      "formula": "(non_interest_expense / (net_interest_income + non_interest_income)) * 100",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "non_interest_expense": 55000,
            "net_interest_income": 80000,
            "non_interest_income": 20000
          },
          "expected_output": 55.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "lcr",
      "name": "Liquidity Coverage Ratio",
      "formula": "(high_quality_liquid_assets / total_net_cash_outflows) * 100",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "high_quality_liquid_assets": 1300000,
            "total_net_cash_outflows": 1000000
          },
          "expected_output": 130.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "loan_loss_reserve_ratio",
      "name": "Loan Loss Reserve to Total Loans",
      "formula": "(allowance_for_credit_losses / total_loans_outstanding) * 100",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "allowance_for_credit_losses": 150000,
            "total_loans_outstanding": 10000000
          },
          "expected_output": 1.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "dti",
      "name": "Debt to Income Ratio",
      "formula": "(monthly_debt_payments / monthly_gross_income) * 100",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "monthly_debt_payments": 3600,
            "monthly_gross_income": 10000
          },
          "expected_output": 36.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "loan_yield",
      "name": "Gross Commercial Loan Yield",
      "formula": "(interest_fee_income / average_loan_balance) * 100",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "interest_fee_income": 70000,
            "average_loan_balance": 1000000
          },
          "expected_output": 7.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "pcl_rate",
      "name": "Provision for Credit Losses Rate",
      "formula": "(credit_loss_provision / average_loans) * 100",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "credit_loss_provision": 40000,
            "average_loans": 10000000
          },
          "expected_output": 0.4,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "return_on_rwa",
      "name": "Return on Risk Weighted Assets",
      "formula": "(net_income / risk_weighted_assets) * 100",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "net_income": 160000,
            "risk_weighted_assets": 8000000
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "deposit_loan_ratio",
      "name": "Loan to Deposit Ratio",
      "formula": "(total_loans / total_deposits) * 100",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_loans": 8500000,
            "total_deposits": 10000000
          },
          "expected_output": 85.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "concentration_index",
      "name": "Single Sector Exposure Ratio",
      "formula": "(sector_exposure / total_capital) * 100",
      "data_source": "folio_k64_ledger",
      "golden_tests": [
        {
          "inputs": {
            "sector_exposure": 2000000,
            "total_capital": 10000000
          },
          "expected_output": 20.0,
          "tolerance": 0.01
        }
      ]
    }
