  "calculators": [
    {
      "calculator_id": "heat_rate",
      "name": "Turbine Thermal Heat Rate",
      "formula": "fuel_energy_input_btu / net_generated_kwh",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "fuel_energy_input_btu": 7500000,
            "net_generated_kwh": 1000
          },
          "expected_output": 7500.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "capacity_factor",
      "name": "Plant Generation Capacity Factor",
      "formula": "(actual_generated_mwh / (nameplate_capacity_mw * period_hours)) * 100",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_generated_mwh": 60000,
            "nameplate_capacity_mw": 100,
            "period_hours": 720
          },
          "expected_output": 83.3333,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "saidi",
      "name": "System Average Interruption Duration Index",
      "formula": "total_customer_outage_minutes / total_customers_served",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_customer_outage_minutes": 120000,
            "total_customers_served": 1000
          },
          "expected_output": 120.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "saifi",
      "name": "System Average Interruption Frequency Index",
      "formula": "total_customer_interruptions / total_customers_served",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_customer_interruptions": 1500,
            "total_customers_served": 1000
          },
          "expected_output": 1.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "lcoe",
      "name": "Levelized Cost of Electricity",
      "formula": "total_lifecycle_cost / lifetime_energy_production_mwh",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_lifecycle_cost": 5000000,
            "lifetime_energy_production_mwh": 100000
          },
          "expected_output": 50.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "transmission_losses",
      "name": "Line Transmission Loss Percentage",
      "formula": "((generated_mwh - delivered_mwh) / generated_mwh) * 100",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "generated_mwh": 100000,
            "delivered_mwh": 94000
          },
          "expected_output": 6.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "reserve_margin",
      "name": "Grid Generation Reserve Margin",
      "formula": "((total_capacity_mw - peak_demand_mw) / peak_demand_mw) * 100",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_capacity_mw": 1200,
            "peak_demand_mw": 1000
          },
          "expected_output": 20.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "eaf",
      "name": "Equivalent Availability Factor",
      "formula": "(available_hours / period_hours) * 100",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "available_hours": 700,
            "period_hours": 720
          },
          "expected_output": 97.2222,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "renewable_fraction",
      "name": "Renewable Generation Fraction",
      "formula": "(renewable_mwh / total_generation_mwh) * 100",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "renewable_mwh": 35000,
            "total_generation_mwh": 100000
          },
          "expected_output": 35.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "carbon_intensity",
      "name": "Emissions Intensity per MWh",
      "formula": "co2_metric_tons / generated_mwh",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "co2_metric_tons": 450,
            "generated_mwh": 1000
          },
          "expected_output": 0.45,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "unplanned_outage_rate",
      "name": "Forced Outage Rate",
      "formula": "(forced_outage_hours / (operating_hours + forced_outage_hours)) * 100",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "forced_outage_hours": 20,
            "operating_hours": 480
          },
          "expected_output": 4.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "peak_demand_variance",
      "name": "Peak Load Forecast Variance",
      "formula": "actual_peak_mw - forecast_peak_mw",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_peak_mw": 1050,
            "forecast_peak_mw": 1000
          },
          "expected_output": 50.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "fuel_stock_burn_days",
      "name": "Fuel Inventory Days Remaining",
      "formula": "current_stock_tons / daily_burn_rate_tons",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "current_stock_tons": 60000,
            "daily_burn_rate_tons": 2000
          },
          "expected_output": 30.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "meter_reading_accuracy",
      "name": "Smart Meter Data Delivery Completeness",
      "formula": "(successful_reads / total_scheduled_reads) * 100",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "successful_reads": 9950,
            "total_scheduled_reads": 10000
          },
          "expected_output": 99.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "ramp_rate_compliance",
      "name": "Ramp Rate Compliance Ratio",
      "formula": "actual_mw_per_min / dispatched_mw_per_min",
      "data_source": "folio_d35_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_mw_per_min": 18,
            "dispatched_mw_per_min": 20
          },
          "expected_output": 0.9,
          "tolerance": 0.01
        }
      ]
    }
  ],
