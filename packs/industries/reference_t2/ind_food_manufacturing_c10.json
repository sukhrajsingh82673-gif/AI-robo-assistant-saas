  "calculators": [
    {
      "calculator_id": "batch_yield",
      "name": "Batch Output Yield",
      "formula": "(actual_yield_kg / theoretical_yield_kg) * 100",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_yield_kg": 950,
            "theoretical_yield_kg": 1000
          },
          "expected_output": 95.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "moisture_ratio",
      "name": "Moisture Ratio Variance",
      "formula": "actual_moisture - target_moisture",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_moisture": 14.5,
            "target_moisture": 12.0
          },
          "expected_output": 2.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cip_water_intensity",
      "name": "Clean-in-Place Water Intensity",
      "formula": "water_consumed_liters / batch_weight_kg",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "water_consumed_liters": 5000,
            "batch_weight_kg": 2500
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "thermal_death_variance",
      "name": "Pasteurization Thermal Hold Variance",
      "formula": "actual_hold_secs - required_hold_secs",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_hold_secs": 18,
            "required_hold_secs": 15
          },
          "expected_output": 3.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "cold_chain_excursion_rate",
      "name": "Cold Chain Excursion Rate",
      "formula": "(excursion_minutes / total_transit_minutes) * 100",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "excursion_minutes": 15,
            "total_transit_minutes": 1500
          },
          "expected_output": 1.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "raw_material_waste_ratio",
      "name": "Raw Ingredient Spoilage Ratio",
      "formula": "(spoiled_weight / intake_weight) * 100",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "spoiled_weight": 20,
            "intake_weight": 1000
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "packaging_fill_accuracy",
      "name": "Packaging Overfill Percentage",
      "formula": "((actual_fill_grams - target_fill_grams) / target_fill_grams) * 100",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_fill_grams": 505,
            "target_fill_grams": 500
          },
          "expected_output": 1.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "energy_per_ton",
      "name": "Specific Energy Consumption per Ton",
      "formula": "total_kwh_consumed / total_tons_produced",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "total_kwh_consumed": 12000,
            "total_tons_produced": 60
          },
          "expected_output": 200.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "allergen_rinse_efficiency",
      "name": "Allergen Cleanout Verification Factor",
      "formula": "residual_ppm / allowable_threshold_ppm",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "residual_ppm": 2,
            "allowable_threshold_ppm": 10
          },
          "expected_output": 0.2,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "shelf_life_index",
      "name": "Remaining Shelf Life Fraction",
      "formula": "days_to_expiry / total_shelf_life_days",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "days_to_expiry": 180,
            "total_shelf_life_days": 360
          },
          "expected_output": 0.5,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "line_recovery_velocity",
      "name": "Line Sanitation Recovery Rate",
      "formula": "sanitation_mins / standard_sanitation_mins",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "sanitation_mins": 45,
            "standard_sanitation_mins": 60
          },
          "expected_output": 0.75,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "byproduct_utilization",
      "name": "Organic Byproduct Recovery Rate",
      "formula": "(recycled_byproduct_kg / total_byproduct_kg) * 100",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "recycled_byproduct_kg": 400,
            "total_byproduct_kg": 500
          },
          "expected_output": 80.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "downtime_micro_stops",
      "name": "Micro-Stop Frequency per Shift",
      "formula": "micro_stop_count / shift_hours",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "micro_stop_count": 16,
            "shift_hours": 8
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "ingredient_batch_variance",
      "name": "Ingredient Dosing Variance",
      "formula": "actual_dosing_kg - formula_target_kg",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "actual_dosing_kg": 102,
            "formula_target_kg": 100
          },
          "expected_output": 2.0,
          "tolerance": 0.01
        }
      ]
    },
    {
      "calculator_id": "traceability_audit_velocity",
      "name": "Traceability One-Up One-Down Velocity",
      "formula": "lookup_duration_minutes / allowable_sla_mins",
      "data_source": "folio_c10_ledger",
      "golden_tests": [
        {
          "inputs": {
            "lookup_duration_minutes": 15,
            "allowable_sla_mins": 120
          },
          "expected_output": 0.125,
          "tolerance": 0.01
        }
      ]
    }
